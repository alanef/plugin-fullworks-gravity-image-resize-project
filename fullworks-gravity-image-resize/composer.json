{
    "name": "fullworks/fullworks-gravity-image-resize",
    "description": "Downscales images uploaded through Gravity Forms file-upload fields.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
