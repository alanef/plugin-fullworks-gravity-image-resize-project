{
  "name": "fullworks/fullworks-gravity-image-resize-project",
  "description": "Development project for the Fullworks Gravity Image Resize WordPress plugin",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "alan",
      "email": "alan@fullworksplugins.com"
    }
  ],
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "wp-coding-standards/wpcs": ">=2.3.0",
    "phpcompatibility/phpcompatibility-wp": "*",
    "phpunit/phpunit": "^9.5",
    "yoast/phpunit-polyfills": "^1.1"
  },
  "scripts": {
    "post-update-cmd": [
      "@plugin-update",
      "@make-pot"
    ],
    "plugin-update": "if [ -f fullworks-gravity-image-resize/composer.json ]; then composer update -d fullworks-gravity-image-resize; fi",
    "make-pot": "mkdir -p fullworks-gravity-image-resize/languages && wp i18n make-pot ./fullworks-gravity-image-resize ./fullworks-gravity-image-resize/languages/fullworks-gravity-image-resize.pot --skip-audit --exclude='vendor,includes/vendor,node_modules'",
    "build": [
      "if [ -f fullworks-gravity-image-resize/composer.json ]; then composer install -d fullworks-gravity-image-resize --no-dev; fi",
      "mkdir -p zipped",
      "wp dist-archive fullworks-gravity-image-resize zipped/fullworks-gravity-image-resize-free.zip --force"
    ],
    "phpcs": "phpcs fullworks-gravity-image-resize -s --standard=phpcs_sec.xml --ignore=*/vendor/* --extensions=php",
    "compat:8.4": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.4",
    "compat:8.3": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.3",
    "compat:8.2": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.2",
    "compat:8.1": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.1",
    "compat:8.0": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 8.0",
    "compat:7.4": "phpcs fullworks-gravity-image-resize -s --standard=PHPCompatibilityWP --ignore=*/vendor/* --extensions=php --runtime-set testVersion 7.4",
    "check": [
      "@compat:8.4",
      "@compat:8.3",
      "@compat:8.2",
      "@compat:8.1",
      "@compat:8.0",
      "@compat:7.4",
      "@phpcs"
    ],
    "test": "npm test"
  }
}
